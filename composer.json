{
  "name": "nodes/assets",
  "description": "Package to make upload and generation of urls matching the files",
  "keywords": [
    "nodes",
    "assets",
    "files",
    "cdn",
    "s3",
    "laravel"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Casper Rasmussen",
      "email": "cr@nodes.dk",
      "role": "CTO"
    },
    {
      "name": "Rasmus Ebbesen",
      "email": "re@nodes.dk",
      "role": "Developer"
    },
    {
      "name": "Morten Rugaard",
      "email": "moru@nodes.dk",
      "role": "Developer"
    }
  ],
  "require": {
    "illuminate/support": "^11.0",
    "illuminate/container": "^11.0",
    "symfony/http-foundation": "^6.4",
    "nodes/core": "dev-laravel-shift-2025",
    "nodes/cache": "dev-laravel-shift-2025",
    "league/flysystem-aws-s3-v3": "^3.8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6.7",
    "orchestra/testbench": "^v7.0"
  },
  "autoload": {
    "psr-4": {
      "Nodes\\Assets\\": "src/"
    },
    "files": [
      "src/Support/Helpers/Upload.php",
      "src/Support/Helpers/URL.php"
    ]
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/jamesforddesign/core"
    },
    {
      "type": "vcs",
      "url": "https://github.com/jamesforddesign/cache"
    }
  ]
}
